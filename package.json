{
  "name": "ekdk-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/setup-pdf-assets.mjs",
    "prebuild": "node scripts/setup-pdf-assets.mjs",
    "inspect:runways": "node scripts/inspect-aerodromes.mjs",
    "verify:ils": "node scripts/inspect-ils.mjs",
    "update:runways": "node scripts/inspect-aerodromes.mjs && node scripts/update-runway-data.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "lucide-react": "0.468.0",
    "naviair-charts": "0.1.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
